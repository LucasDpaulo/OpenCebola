# Configuração da SUA instância. npm run setup gera as duas chaves privadas.
NODE_ENV=development
CEBOLA_API_HOST=127.0.0.1
CEBOLA_API_PORT=3001
CEBOLA_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CEBOLA_API_URL=http://localhost:3001
NEXT_PUBLIC_OPENCEBOLA_WEB_URL=http://localhost:3000
CEBOLA_TRUST_PROXY=false
CEBOLA_ALLOW_INSECURE_STREAMS=false
# npm run db:start preenche o Supabase LOCAL sem imprimir as chaves.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Integrações opcionais: descomente apenas quando tiver sua própria credencial.
# CEBOLA_REAL_DEBRID_TOKEN=
# CEBOLA_TMDB_READ_TOKEN=
# CEBOLA_SUBDL_API_KEY=
