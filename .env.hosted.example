# Use seu próprio Supabase ou instalação compatível. Nunca use o ambiente de outra pessoa.
NODE_ENV=production
CEBOLA_API_HOST=127.0.0.1
CEBOLA_API_PORT=3001
CEBOLA_WEB_ORIGIN=https://instance.example.invalid
NEXT_PUBLIC_CEBOLA_API_URL=https://instance.example.invalid
NEXT_PUBLIC_OPENCEBOLA_WEB_URL=https://instance.example.invalid
CEBOLA_TRUST_PROXY=false
# Configure no .env privado: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SERVICE_ROLE_KEY e as chaves geradas por npm run setup.
